<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  NOVA Auto-Start LaunchAgent

  TO INSTALL (auto-start NOVA when Mac boots):

  1. Edit this file: replace NOVA_FOLDER_PATH with the actual path to your NOVA folder
     e.g. /Users/yourname/Projects/NOVA

  2. Run in Terminal:
     cp nova-launch-agent/com.mrv.nova.plist ~/Library/LaunchAgents/
     launchctl load ~/Library/LaunchAgents/com.mrv.nova.plist

  TO UNINSTALL:
     launchctl unload ~/Library/LaunchAgents/com.mrv.nova.plist
     rm ~/Library/LaunchAgents/com.mrv.nova.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mrv.nova</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>NOVA_FOLDER_PATH/start-nova.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/nova-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/nova-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>YOUR_HOME_PATH</string>
    </dict>
</dict>
</plist>
