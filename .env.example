# ─── AIRA Environment Variables ────────────────────────────────────────────────
# Copy this file to .env and fill in your API keys

# LLM Provider: "groq" (cloud, free tier) or "ollama" (local, unlimited, private)
# Set to "ollama" for zero rate limits and full privacy.
LLM_PROVIDER=groq

# Ollama settings (only needed when LLM_PROVIDER=ollama)
# Install: brew install ollama && ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# Groq API Key (FREE) — https://console.groq.com
# Only needed when LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# OpenWeatherMap API Key (FREE) — https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# NewsAPI Key (FREE) — https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here
